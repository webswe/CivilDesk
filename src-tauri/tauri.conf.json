{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CivilDesk",
  "version": "0.1.0",
  "identifier": "com.webswe.civildesk",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "CivilDesk", "width": 1280, "height": 820, "minWidth": 650, "minHeight": 600, "backgroundColor": "#211B20" }], "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"], "windows": { "nsis": { "installMode": "currentUser" }, "webviewInstallMode": { "type": "offlineInstaller" } } }
}
