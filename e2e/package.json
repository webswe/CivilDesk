{
  "name": "civildesk-e2e",
  "private": true,
  "type": "module",
  "description": "Native Windows acceptance tests. Drives the real CivilDesk E2E binary through tauri-driver. Never touches production or Acceptance data.",
  "scripts": {
    "test": "wdio run wdio.conf.mjs",
    "test:smoke": "wdio run wdio.conf.mjs --spec specs/01-smoke-persistence.e2e.mjs",
    "verify": "node scripts/verify-results.mjs"
  },
  "devDependencies": {
    "@wdio/cli": "^9.19.0",
    "@wdio/junit-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.19.0",
    "@wdio/mocha-framework": "^9.19.0",
    "@wdio/spec-reporter": "^9.19.0"
  }
}
